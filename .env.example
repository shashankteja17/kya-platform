# Local demo mode uses the clearly labelled KYA extension evaluator.
KYA_MODE=demo-extension
# Set to agt-required after installing AGT and creating a valid ACS manifest.
# In agt-required mode the app fails closed if AGT/ACS is missing or evaluation fails.
# KYA_MODE=agt-required
AGT_MANIFEST_PATH=backend/policies/manifest.yaml
KYA_ADMIN_API_KEY=replace-this-local-demo-key
KYA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# Optional: DATABASE_URL=sqlite:///./backend/kya.db
